{# The full report: DESIGN §9.1 sections 1, 3, 4, 9, 10.

   Sections 2, 5, 6, 7 and 8 are deliberately not stubbed — an empty "Verdict" page is worse than
   no verdict page. What they *would* contain is listed once, in § Caveats, with the milestone that
   fills each in.

   Every value here is already a string. No arithmetic, no number-formatting filter, no `|safe`. #}
{% import "_macros.html.j2" as m %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ model.cover.ticker }} — {{ model.cover.name }} — {{ model.cover.as_of }}</title>
  <meta name="generator" content="{{ model.run.generated_by }}">
</head>
<body>

<section class="cover">
  <p class="eyebrow">Fundamental due diligence · SEC filings only</p>
  <h1>{{ model.cover.ticker }}</h1>
  <p class="company">{{ model.cover.name }}</p>
  <p class="asof">as of {{ model.cover.as_of }}</p>

  <div class="badges">
    <div class="badge">
      <span class="badge-label">Assessment</span>
      <span class="badge-value">{{ model.cover.verdict }}</span>
      <span class="badge-note">{{ model.cover.verdict_note }}</span>
    </div>
    <div class="badge">
      <span class="badge-label">Confidence</span>
      <span class="badge-value">{{ model.cover.confidence }}</span>
      <span class="badge-note">{{ model.cover.confidence_note }}</span>
    </div>
  </div>

  <ul class="measured">
    <li>{{ model.cover.coverage_line }}</li>
    <li>{{ model.cover.quarters_line }}</li>
  </ul>

  <p class="disclaimer">{{ model.cover.disclaimer }}</p>
</section>

<section class="page">
  <h2>1. Company snapshot</h2>
  {{ m.pairs(model.snapshot.rows) }}
  <dl class="pairs">
    <dt>Market capitalisation</dt>
    <dd>{{ model.snapshot.market_cap }}
      {% if model.snapshot.market_cap_note %}<span class="note">{{ model.snapshot.market_cap_note }}</span>{% endif %}
    </dd>
  </dl>
  {% for text in model.snapshot.omissions %}{{ m.omission(text) }}{% endfor %}
</section>

<section class="page">
  <h2>2. Historical performance</h2>
  {% for image in model.history.charts %}{{ m.chart(image) }}{% endfor %}
  {% for text in model.history.omissions %}{{ m.omission(text) }}{% endfor %}
</section>

<section class="page">
  <h2>3. Caveats</h2>

  <h3>Data coverage</h3>
  <p>Denominator: {{ model.caveats.spine_origin }}.</p>
  {% if model.caveats.spine_warning %}{{ m.omission(model.caveats.spine_warning) }}{% endif %}
  {{ m.table(model.caveats.coverage) }}

  <h3>What this report does not contain</h3>
  <ul class="absences">
    {% for what, milestone in model.caveats.absent_sections %}
    <li>{{ what }} <span class="note">ROADMAP {{ milestone }}</span></li>
    {% endfor %}
  </ul>

  <h3>Measured accuracy</h3>
  <p>{{ model.caveats.accuracy }}</p>

  {% if model.caveats.gates %}
  <h3>Recorded gates</h3>
  <ul class="absences">
    {% for text in model.caveats.gates %}<li>{{ text }}</li>{% endfor %}
  </ul>
  {% endif %}

  <h3>Findings</h3>
  {% if model.caveats.findings %}
  <dl class="pairs">
    {% for row in model.caveats.findings %}
    <dt>{{ row.label }}</dt>
    <dd>{{ row.cells[0] }}{% if row.note %} <span class="note">{{ row.note }}</span>{% endif %}</dd>
    {% endfor %}
  </dl>
  {% else %}
  <p>None recorded during normalization.</p>
  {% endif %}
</section>

<section class="page">
  <h2>4. Appendix</h2>
  {{ m.table(model.appendix.annual) }}
  {{ m.table(model.appendix.quarterly) }}

  <h3>Sources</h3>
  <p>Indices match the <code>sources</code> array in <code>report.json</code>.</p>
  {{ m.table(model.appendix.sources) }}

  <h3>Run</h3>
  <dl class="pairs">
    <dt>Generated by</dt><dd>{{ model.run.generated_by }}</dd>
    <dt>Ticker</dt><dd>{{ model.run.ticker }}</dd>
    <dt>Cache manifest hash</dt><dd class="mono">{{ model.appendix.manifest_hash }}</dd>
  </dl>
  {{ m.pairs(model.appendix.config) }}
</section>

</body>
</html>
