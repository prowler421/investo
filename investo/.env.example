# Investo environment variables. Copy to `.env` and fill in.
#
# Every variable uses the INVESTO_ prefix, including the LLM provider keys. That is a
# deliberate choice over reading ANTHROPIC_API_KEY and friends from the ambient environment:
# config resolution then has one convention rather than two, and a key that arrives by accident
# from a shell profile cannot silently enable a paid code path.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SEC requires a declared User-Agent, documented format `<app name> <contact email>`. There is
# no default and startup fails without it (exit code 5) — a `python-requests/...` UA earns an
# "Undeclared Automated Tool" error, and a fabricated default would send someone else's traffic
# under a contact address that cannot answer for it. Put a real address here.
INVESTO_SEC_USER_AGENT="Investo research your.email@example.com"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Price data. Free key at https://www.tiingo.com/. Without it the price provider falls back per
# config; note the free tier is non-commercial (DESIGN.md §4.3).
INVESTO_TIINGO_KEY=

# Narrative analysis. Only the key for the provider passed to `--llm` is read; `--llm none`
# (the default) reads none of them and the report is complete without it.
INVESTO_ANTHROPIC_KEY=
INVESTO_OPENAI_KEY=
INVESTO_GEMINI_KEY=

# Paths. Both are also settable per-run with `--cache-dir` and `--out`.
# INVESTO_CACHE_DIR=./.cache
# INVESTO_OUT_DIR=./reports

# Price provider: tiingo | yfinance | stooq
# INVESTO_PRICE_PROVIDER=tiingo
